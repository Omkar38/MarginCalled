# Secrets — NEVER commit. The competition repo is public.
.env
.env.*
!.env.example
*.pem
*credentials*
*secret*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Runtime artefacts
audit/
logs/
*.log
snapshots/

# Runtime scan output — regenerable, changes every scan.
# Snapshot a final copy manually before submission if it's wanted as evidence.
data/
# Note: reports/* not reports/ - git cannot re-include a file inside an
# excluded DIRECTORY, so the negations below only work if the contents are
# excluded rather than the folder itself.
reports/*
# The evidence pack and the narrations are deliverables, not scan noise.
# A judge should be able to read them straight from the repo.
!reports/COMPLIANCE.md
!reports/*_narration.md
!reports/BACKTEST_SIZING.md
.DS_Store

# Compressed snapshot of the scan output, committed on purpose: the dashboard is
# built elsewhere from the repository alone, so its data has to travel with it.
# data/ itself stays ignored - it is live, large and changes every scan.
!dashboard_data/
