# TEMPLATE ONLY — never put real keys in this file. It is committed to the repo.
# Copy it to .env (gitignored) and fill that in instead:
#     cp .env.example .env
#
# Paper keys begin with PK. Live keys (AK...) are refused by the probe.

APCA_API_KEY_ID=PK_your_key_id_here
APCA_API_SECRET_KEY=your_secret_here

# Optional
TP2_SHORT_RATE=0.045
